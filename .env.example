# Copy to .env at the repository root; keep it private (chmod 600) and untracked.
# Required for the local Metabase Docker Compose deployment:
MB_DB_PASSWORD=replace-with-the-existing-database-password
# Required to set up or rotate the Metabase administrator:
METABASE_ADMIN_EMAIL=replace-with-the-admin-email
METABASE_ADMIN_PASSWORD=replace-with-the-admin-password
# Optional: GitHub repository traffic credential (repository write access).
# GITHUB_TRAFFIC_TOKEN=replace-with-a-GitHub-credential
# Optional: PostHog project token (phc_...), for sending events and logs only.
# POSTHOG_PROJECT_TOKEN=phc_replace-with-your-project-token
# POSTHOG_HOST=https://us.i.posthog.com
# Optional: read-only API access to query PostHog aggregates for Metabase.
# POSTHOG_PROJECT_ID=your-numeric-project-id
# POSTHOG_PERSONAL_API_KEY=phx_your-key-with-query:read-and-logs:read
