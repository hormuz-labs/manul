# Vendor keys: only the gateway holds them.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# The development Manul key (virtual key vk-dev in config.json).
MANUL_DEV_KEY=sk-bf-dev-change-me
# Unlocks the dashboard and admin API the first time (create the admin account, then per-user keys).
BIFROST_SETUP_TOKEN=change-me
