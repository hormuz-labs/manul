# Production secrets for manul-secrets. Copy to gateway/k8s/.env (never committed) and fill in what you have.
# deploy.sh (or set-secrets.sh alone) puts every non-empty value here into the cluster secret. Keys left empty or
# missing keep what's already in the cluster (e.g. the generated admin password and the Postgres login).

# Clerk production: dashboard → API keys → Secret keys
CLERK_SECRET_KEY=
# Dodo Payments (test mode until going live): Developer → API keys; Webhooks → the endpoint's signing secret
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=

# Vendors
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Azure AI Foundry: the resource's endpoint (https://<name>.services.ai.azure.com) and key
AZURE_ENDPOINT=
AZURE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
